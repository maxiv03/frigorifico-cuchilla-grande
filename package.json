    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true,
    "@tailwindcss/oxide": true,
