    "qa:catalog": "tsx scripts/qa-catalog.ts",
    "qa:institutional": "tsx scripts/qa-institutional.ts",
    "qa:fixes": "tsx scripts/qa-fixes.ts",
    "qa:layout": "node scripts/qa-layout.mjs",
