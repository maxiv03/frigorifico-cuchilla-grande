# Copiar a .env.local y completar. Sin valores reales en este archivo.
# Valores con caracteres especiales: entre comillas simples.
# En Vercel: SUPABASE_SECRET_KEY, CRON_SECRET e IP_HASH_SALT como variables sensibles.
# VERCEL_ENV, VERCEL_URL y VERCEL_PROJECT_PRODUCTION_URL las define Vercel (no van acá).

# ─── Supabase ───────────────────────────────────────────────────────────────
# Ninguna lleva NEXT_PUBLIC_: el navegador nunca habla con Supabase.
SUPABASE_URL=''               # https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=''   # sb_publishable_… · rol anon: lecturas de contenido e inserts de formularios
SUPABASE_SECRET_KEY=''        # sb_secret_… · SOLO el cron y los scripts (seed, pruebas, QA)
SUPABASE_DB_URL=''            # session pooler (postgresql://…), solo para `npm run db:push`; no va a Vercel

# ─── Secretos de la app ─────────────────────────────────────────────────────
CRON_SECRET=''                # openssl rand -hex 32 · Vercel lo manda como Authorization: Bearer
IP_HASH_SALT=''               # openssl rand -hex 32 (mín. 32 caracteres) · sal del hash de IP de los formularios

# ─── Contacto del equipo (demo) ─────────────────────────────────────────────
CONTACT_EMAIL=''              # mail del equipo (postulaciones, consultas)
WHATSAPP_NUMBER=''            # solo dígitos, con código de país (p. ej. 598…)

# ─── Sitio ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL='http://localhost:3000'   # URL pública sin barra final (canonical, sitemap, OG)

# Indexación. Por defecto false: noindex,nofollow, robots.txt bloquea todo y X-Robots-Tag.
# "true" solo para demostrar el modo indexable (se lee en el build: requiere deploy nuevo).
SITE_INDEXABLE='false'

# CSP estricta en report-only, solo para auditar (en producción baja "Buenas prácticas" de Lighthouse).
CSP_STRICT_REPORT_ONLY='false'
