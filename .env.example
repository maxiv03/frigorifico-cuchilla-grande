# Copiar a .env.local. Valores con caracteres especiales: entre comillas simples.
# Supabase (ninguna lleva NEXT_PUBLIC_: el navegador nunca habla con Supabase)
SUPABASE_URL=''
SUPABASE_PUBLISHABLE_KEY=''   # rol anon: lecturas de contenido e inserts de formularios
SUPABASE_SECRET_KEY=''        # SOLO cron y scripts
SUPABASE_DB_URL=''            # session pooler, para `npm run db:push`

CRON_SECRET=''                # openssl rand -hex 32
IP_HASH_SALT=''               # openssl rand -hex 32

CONTACT_EMAIL=''
WHATSAPP_NUMBER=''            # solo dígitos, con código de país
NEXT_PUBLIC_SITE_URL='http://localhost:3000'

# Indexación (fase 6). Por defecto false: noindex,nofollow, robots.txt bloquea todo y X-Robots-Tag.
# "true" solo para demostrar el modo indexable (se lee en el build: requiere deploy nuevo).
SITE_INDEXABLE='false'
# CSP estricta en report-only, solo para auditar (en producción baja "Buenas prácticas" de Lighthouse).
CSP_STRICT_REPORT_ONLY='false'
